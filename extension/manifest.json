{
  "manifest_version": 3,
  "name": "تحليل الريلز — Reels Analysis",
  "version": "1.9.0",
  "description": "Personal Instagram reel research: outlier grid, reel stats, folders, downloads, and full video control.",
  "permissions": [
    "storage",
    "tabs",
    "downloads",
    "alarms"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "تحليل الريلز",
    "default_popup": "src/ui/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "src/data/ig.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "lib/phosphor/icons.js",
        "lib/i18n.js",
        "lib/i18n-app.js",
        "src/data/bridge.js",
        "src/ui/app.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "lib/i18n.js",
        "lib/i18n-app.js",
        "src/video/overlay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*",
        "src/ui/*"
      ],
      "matches": [
        "https://www.instagram.com/*"
      ]
    }
  ],
  "commands": {
    "toggle-app": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Open / close the reels grid on this page"
    }
  },
  "homepage_url": "https://aminellkadaoui.github.io/amine-reels/"
}